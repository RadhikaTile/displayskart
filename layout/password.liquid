<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name }}</title>
{{ 'theme.css' | asset_url | stylesheet_tag }}{{ content_for_header }}
<style>:root{--bg:{{ settings.color_bg }};--card:{{ settings.color_card }};--ink:{{ settings.color_ink }};--mute:{{ settings.color_mute }};--line:{{ settings.color_line }};--ph:{{ settings.color_ph }};--cream:{{ settings.color_cream }};--acc:{{ settings.color_accent }};--sale:{{ settings.color_sale }};--font-body:system-ui,sans-serif;--font-head:Georgia,serif}</style></head>
<body style="background:var(--bg)">{{ content_for_layout }}</body></html>
