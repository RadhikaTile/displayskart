<div class="w" style="max-width:560px;padding-top:20px;margin-bottom:30px"><div class="bx2">
  <h3 style="margin-top:0">Create account</h3>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<p class="err">{{ form.errors | default_errors }}</p>{%- endif -%}
    <input type="text" name="customer[first_name]" placeholder="First name" required style="margin-bottom:10px">
    <input type="text" name="customer[last_name]" placeholder="Last name" style="margin-bottom:10px">
    <input type="email" name="customer[email]" placeholder="Email *" required style="margin-bottom:10px">
    <input type="password" name="customer[password]" placeholder="Password *" required style="margin-bottom:10px">
    <p><button class="btn fill" type="submit">Register</button> &nbsp; <a href="{{ routes.account_login_url }}"><u>Already registered? Sign in</u></a></p>
  {%- endform -%}
</div></div>

{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}
