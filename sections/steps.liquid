<section><div class="w">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
  <div class="steps">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}<div class="stp" {{ block.shopify_attributes }}><span class="n">{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{%- endfor -%}
    {%- else -%}
      <div class="stp"><span class="n">1</span><h3>Choose</h3><p>Browse sign holders, frames, donation boxes and more.</p></div>
      <div class="stp"><span class="n">2</span><h3>Customise</h3><p>Need a custom size or branding? Contact us for a quote.</p></div>
      <div class="stp"><span class="n">3</span><h3>Pay Securely</h3><p>Safe online payment with order confirmation.</p></div>
      <div class="stp"><span class="n">4</span><h3>Delivered</h3><p>Pan-India delivery — free shipping above ₹1000.</p></div>
    {%- endif -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Simple process"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Order"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Sub text"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
