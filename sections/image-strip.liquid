<section><div class="w">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
  <div class="ig">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<div {{ block.shopify_attributes }}>{%- endif -%}
        {% render 'img', image: block.settings.image, ratio: '1/1', sizes: '(min-width:900px) 190px, 33vw' %}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <div>{% render 'img', ratio: '1/1', placeholder: 'lifestyle-1', sizes: '(min-width:900px) 190px, 33vw' %}</div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Image strip",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Follow us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@displayskart"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Sub text"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image strip",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
