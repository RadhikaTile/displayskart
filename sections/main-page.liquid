{%- assign h = page.handle -%}
{%- if h == 'about' or h == 'about-us' -%}
  <div class="pgh"><div class="w"><div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ page.title }}</div><h1>About DisplaysKart</h1></div></div>
  <div class="w">
    <div class="g2" style="margin:20px 0;align-items:center">
      <div class="art">
        <p>DisplaysKart is India’s trusted acrylic display store, serving retailers, hotels, offices, NGOs and exhibitions with premium acrylic sign holders, photo frames, donation boxes and risers.</p>
        <p>We are dedicated to revolutionizing your display experience with quality, innovative solutions tailored to your unique needs.</p>
        <a class="btn fill" href="{{ routes.root_url }}pages/contact">Talk to us</a>
      </div>
      <div>{% render 'img', ratio: '600/420', placeholder: 'lifestyle-1', demo_index: 3, sizes: '(min-width:900px) 580px, 100vw' %}</div>
    </div>
    <div class="g4" style="margin:30px 0">
      <div class="stat bx2"><b>500+</b>Products</div>
      <div class="stat bx2"><b>10,000+</b>Orders shipped</div>
      <div class="stat bx2"><b>Pan-India</b>Delivery</div>
      <div class="stat bx2"><b>5%</b>Bulk discount</div>
    </div>
    <div class="sh"><h2>Why choose us</h2></div>
    <div class="g4" style="margin-bottom:40px">
      <div class="bx2"><b>Premium Quality</b><p style="margin:6px 0 0;color:var(--mute)">Clear, durable acrylic</p></div>
      <div class="bx2"><b>Custom Sizes</b><p style="margin:6px 0 0;color:var(--mute)">Made to your spec</p></div>
      <div class="bx2"><b>Fast Shipping</b><p style="margin:6px 0 0;color:var(--mute)">Free above ₹1000</p></div>
      <div class="bx2"><b>Support</b><p style="margin:6px 0 0;color:var(--mute)">Help center & sales team</p></div>
    </div>
  </div>
{%- elsif h == 'applications' -%}
  <div class="pgh"><div class="w"><div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ page.title }}</div><h1>Industries We Serve</h1><p class="muted" style="margin:6px 0 0">Acrylic display solutions for every environment.</p></div></div>
  <div class="w" style="margin-bottom:40px">
    <div class="g2" style="margin:34px 0;align-items:center">
      <div>{% render 'img', ratio: '600/380', placeholder: 'collection-1', demo_index: 4, sizes: '(min-width:900px) 580px, 100vw' %}</div>
      <div><h2>Office Suppliers &amp; Organizer</h2><p>Name plates, label holders, brochure organizers and desk organizers for professional workspaces.</p><a class="btn fill" href="{{ routes.collections_url }}/acrylic-label-holders-signs">Shop now</a></div>
    </div>
    <div class="g2" style="margin:34px 0;align-items:center;direction:rtl">
      <div>{% render 'img', ratio: '600/380', placeholder: 'collection-1', demo_index: 7, sizes: '(min-width:900px) 580px, 100vw' %}</div>
      <div style="direction:ltr"><h2>NGO’s &amp; Government Organizations</h2><p>Transparent donation, suggestion and ballot boxes with lock and key.</p><a class="btn fill" href="{{ routes.collections_url }}/acrylic-donation-box">Shop now</a></div>
    </div>
    <div class="g2" style="margin:34px 0;align-items:center">
      <div>{% render 'img', ratio: '600/380', placeholder: 'collection-1', demo_index: 12, sizes: '(min-width:900px) 580px, 100vw' %}</div>
      <div><h2>Galleries and Museums</h2><p>Wall-mount stud frames, shadow boxes and display risers that keep the focus on the exhibit.</p><a class="btn fill" href="{{ routes.collections_url }}/acrylic-wall-mount-display-frames">Shop now</a></div>
    </div>
    <div class="g2" style="margin:34px 0;align-items:center;direction:rtl">
      <div>{% render 'img', ratio: '600/380', placeholder: 'collection-1', demo_index: 15, sizes: '(min-width:900px) 580px, 100vw' %}</div>
      <div style="direction:ltr"><h2>Retail Displays for shops</h2><p>Riser stands, purse stands, easels and sign holders to lift sales.</p><a class="btn fill" href="{{ routes.collections_url }}/exclusive-product">Shop now</a></div>
    </div>
    <div class="g2" style="margin:34px 0;align-items:center">
      <div>{% render 'img', ratio: '600/380', placeholder: 'collection-1', demo_index: 2, sizes: '(min-width:900px) 580px, 100vw' %}</div>
      <div><h2>Home Interior Photo Frames</h2><p>Magnetic and floating acrylic photo frames for homes and gifting.</p><a class="btn fill" href="{{ routes.collections_url }}/acrylic-photo-frames">Shop now</a></div>
    </div>
  </div>
{%- elsif h == 'track-order' or h == 'track' -%}
  <div class="pgh"><div class="w">
    <div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ page.title | default: 'Track Order' }}</div>
    <h1>Track Your Order</h1>
    <p class="muted" style="margin:6px 0 0">Check the status of your order or follow your shipment with the courier.</p>
  </div></div>
  <div class="w"><div class="g2" style="align-items:start;margin-bottom:30px">
    <div>
      <div class="bx2">
        <h3 style="margin-top:0">Your orders</h3>
        <p class="muted" style="margin-top:0">Signed-in customers can see the live status of every order, including tracking links.</p>
        {%- if customer -%}
          <a class="btn fill" href="{{ routes.account_url }}">View my orders</a>
        {%- else -%}
          <a class="btn fill" href="{{ routes.account_login_url }}">Sign in to track</a> &nbsp;<a class="btn" href="{{ routes.account_register_url }}">Create account</a>
        {%- endif -%}
        <p class="muted" style="font-size:13px;margin-bottom:0">Ordered as a guest? Open the <b>order status</b> link in your confirmation or shipping email.</p>
      </div>
    </div>
    <div>
      <div class="bx2" data-track>
        <h3 style="margin-top:0">Have a courier tracking number?</h3>
        <p class="muted" style="margin-top:0;font-size:14px">Enter it here, then choose your courier.</p>
        <input type="text" data-awb placeholder="Tracking number (AWB)" aria-label="Tracking number">
        <div class="car" style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn" href="https://www.indiapost.gov.in/" target="_blank" rel="noopener">India Post ↗</a>
          <a class="btn" href="https://www.delhivery.com/" target="_blank" rel="noopener">Delhivery ↗</a>
          <a class="btn" href="https://www.bluedart.com/" target="_blank" rel="noopener">Blue Dart ↗</a>
        </div>
      </div>
      <div class="bx2" style="margin-top:16px">
        <h3 style="margin-top:0">Need help?</h3>
        <p class="muted" style="margin-top:0;font-size:14px">Can’t find your order? We’ll look it up for you.</p>
        <p style="margin:0">📞 +91 79000 54449<br>✉ support@displayskart.com</p>
        <p><a class="btn" href="{{ routes.root_url }}pages/contact" style="margin-top:8px">Contact us</a></p>
      </div>
    </div>
  </div></div>
{%- elsif h == 'contact' or h == 'contact-us' -%}
  <div class="pgh"><div class="w"><div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ page.title | default: 'Contact Us' }}</div><h1>{{ page.title | default: 'Contact Us' }}</h1></div></div>
  <div class="w"><div class="g2" style="align-items:start;margin-bottom:30px">
    <div class="bx2">
      <h3 style="margin-top:0">Send us a message</h3>
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}<p style="color:green">Thanks for contacting us. We’ll get back to you soon.</p>{%- endif -%}
        {%- if form.errors -%}<p class="err">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input type="text" name="contact[name]" placeholder="Your name" value="{{ form.name }}" style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--border);border-radius:4px" required>
        <input type="email" name="contact[email]" placeholder="Email" value="{{ form.email }}" style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--border);border-radius:4px" required>
        <input type="tel" name="contact[phone]" placeholder="Phone" value="{{ form.phone }}" style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--border);border-radius:4px">
        <select name="contact[Enquiry type]" aria-label="Enquiry type" style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--border);border-radius:4px"><option>General enquiry</option><option>Bulk / wholesale quote</option><option>Custom size / branding</option><option>Order support</option></select>
        <textarea name="contact[body]" rows="5" placeholder="Message (mention product, size, quantity for bulk quotes)" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:4px" required>{{ form.body }}</textarea><br><br>
        <button class="btn fill" type="submit">Send Message</button>
      {%- endform -%}
    </div>
    <div>
      <div class="bx2" style="margin-bottom:16px">
        <p style="margin-top:0"><b>Displayskart</b><br>Behind Bajaj Show room, 6th Main Road HVR Layout, Kamakshi Palya – 560079, Bangaluru</p>
        <p>📞 +91 79000 54449<br>✉ sales@displayskart.com<br>✉ support@displayskart.com</p>
        <p style="margin-bottom:0">Hours: Mon - Sat: 9:30 AM - 6:30 PM</p>
      </div>
      {% render 'img', ratio: '600/300', placeholder: 'lifestyle-2', demo_index: 8, sizes: '(min-width:900px) 560px, 100vw' %}
    </div>
  </div></div>
{%- else -%}
  <div class="pgh"><div class="w"><div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ page.title }}</div><h1>{{ page.title }}</h1></div></div>
  <div class="w art" style="max-width:860px;padding-bottom:20px">
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      <p class="muted">Content coming soon.</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
