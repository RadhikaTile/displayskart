<section><div class="w"><div class="cdb">
  <div class="tx">
    <small class="cl">{{ section.settings.eyebrow }}</small>
    <h2>{{ section.settings.heading }}</h2>
    <p class="muted">{{ section.settings.text }}</p>
    <div class="cdn" data-countdown data-end="{{ section.settings.end_date }}"></div>
    {%- if section.settings.button_label != blank -%}<a class="btn fill" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
  {% render 'img', image: section.settings.image, ratio: '700/520', placeholder: 'lifestyle-1', sizes: '(min-width:900px) 560px, 100vw' %}
</div></div></section>

{% schema %}
{
  "name": "Countdown banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited-time offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Up to 53% off on selected acrylic displays"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Stock is limited. Order before the timer ends — free shipping above ₹1000."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date & time (YYYY-MM-DDTHH:MM)",
      "info": "Leave blank to count down to the end of the current month."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
