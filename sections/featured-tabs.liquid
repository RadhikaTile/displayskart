<section><div class="w">
  {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
  <div class="tb2" data-tabs-home>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign tab_title = block.settings.title | default: block.settings.collection.title | default: 'Featured' -%}
        <button type="button" class="{% if forloop.first %}on{% endif %}" data-tab-target="{{ block.id }}" {{ block.shopify_attributes }}>{{ tab_title }}</button>
      {%- endfor -%}
    {%- else -%}
      <button type="button" class="on" data-tab-target="tab-featured">Featured</button>
      <button type="button" data-tab-target="tab-signs">Sign Holders</button>
      <button type="button" data-tab-target="tab-frames">Photo Frames</button>
      <button type="button" data-tab-target="tab-donation">Donation Boxes</button>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- assign tab_col = block.settings.collection -%}
      {%- if tab_col == blank or tab_col.products.size == 0 -%}
        {%- assign tab_col = collections['all'] | default: collections.all -%}
      {%- endif -%}
      <div class="g4 js-grid" data-tab-panel="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
        {%- for product in tab_col.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="muted">No products found.</p>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  {%- else -%}
    {%- assign tab_col_handles = 'featured-products,acrylic-sign-holders,acrylic-photo-frames,acrylic-donation-box' | split: ',' -%}
    {%- assign tab_ids = 'tab-featured,tab-signs,tab-frames,tab-donation' | split: ',' -%}
    {%- for handle in tab_col_handles -%}
      {%- assign tid = tab_ids[forloop.index0] -%}
      {%- assign tcol = collections[handle] -%}
      {%- if tcol == blank or tcol.products.size == 0 -%}
        {%- assign tcol = collections['all'] | default: collections.all -%}
      {%- endif -%}
      <div class="g4 js-grid" data-tab-panel="{{ tid }}"{% unless forloop.first %} hidden{% endunless %}>
        {%- for product in tcol.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="muted">No products found.</p>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div></section>

{% schema %}
{
  "name": "Featured products (tabs)",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our picks"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Sub text"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products per tab",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products (tabs)",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
