{%- assign b = section.settings.blog | default: blogs['news'] | default: blogs.first -%}
<section><div class="w">
  <div class="sh"><h2>{{ section.settings.heading }}</h2>{% if b != blank %}<a href="{{ b.url }}">All posts →</a>{% endif %}</div>
  <div class="g3">
    {%- if b != blank and b.articles.size > 0 -%}
      {%- for article in b.articles limit: section.settings.count -%}
        {% render 'article-card', article: article %}
      {%- endfor -%}
    {%- else -%}
      <div class="bc">
        {% render 'img', ratio: '600/380', placeholder: 'lifestyle-1' %}
        <div class="b">
          <small>Buying Guide · DisplaysKart</small>
          <h3>How to Choose the Right Acrylic Sign Holder for Your Business</h3>
          <p>Double-sided holders suit counters and restaurant tables where customers approach from both directions...</p>
        </div>
      </div>
      <div class="bc">
        {% render 'img', ratio: '600/380', placeholder: 'lifestyle-2' %}
        <div class="b">
          <small>Institutions · DisplaysKart</small>
          <h3>Acrylic Donation Boxes for Temples, NGOs and Schools</h3>
          <p>A transparent donation box builds trust because donors can see the collection. Models with lock and key keep contributions secure...</p>
        </div>
      </div>
      <div class="bc">
        {% render 'img', ratio: '600/380', placeholder: 'collection-1' %}
        <div class="b">
          <small>Retail · DisplaysKart</small>
          <h3>5 Retail Display Ideas Using Acrylic Risers</h3>
          <p>Risers create height and draw the eye to small products such as cosmetics, jewellery, eyewear and watches...</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Posts",
      "min": 3,
      "max": 6,
      "step": 3,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ]
}
{% endschema %}
