<section data-recent hidden><div class="w">
  <div class="sh"><h2>{{ section.settings.heading }}</h2></div>
  <div class="g4 js-grid" data-recent-grid></div>
</div></section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    }
  ]
}
{% endschema %}
