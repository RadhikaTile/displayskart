{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<aside id="dr" aria-label="Cart" data-drawer>
  <div class="dh"><b>Shopping Cart</b><button type="button" data-close aria-label="Close">✕</button></div>
  <div id="db">
    {%- if cart.item_count > 0 -%}
      {%- if threshold > 0 -%}
      <div class="fs">
        {%- if cart.total_price >= threshold -%}🎉 You’ve unlocked <b>free shipping</b>!{%- else -%}Add <b>{{ threshold | minus: cart.total_price | money }}</b> more for <b>free shipping</b>{%- endif -%}
        <i style="width:{{ pct }}%"></i>
      </div>
      {%- endif -%}
      {%- for item in cart.items -%}
        <div class="di">
          <div style="width:70px;flex:none">{% render 'img', image: item.image, ratio: '1/1', sizes: '70px' %}</div>
          <div style="flex:1">
            <a href="{{ item.url }}">{{ item.product.title | truncate: 60 }}</a>
            {%- unless item.product.has_only_default_variant -%}<div class="sku">{{ item.variant.title }}</div>{%- endunless -%}
            <div class="pr" style="margin:4px 0">{{ item.final_price | money }}</div>
            <div class="q"><button type="button" data-line="{{ forloop.index }}" data-qty-change="{{ item.quantity | minus: 1 }}">−</button><span>{{ item.quantity }}</span><button type="button" data-line="{{ forloop.index }}" data-qty-change="{{ item.quantity | plus: 1 }}">+</button></div>
          </div>
          <button type="button" class="xq" style="font-size:15px" data-line="{{ forloop.index }}" data-qty-change="0" aria-label="Remove">✕</button>
        </div>
      {%- endfor -%}
      <div style="margin-top:auto;border-top:1px solid var(--line);padding-top:14px">
        <p style="display:flex;justify-content:space-between;margin:0 0 10px"><span>Subtotal</span><b>{{ cart.total_price | money }}</b></p>
        <p style="font-size:12px;color:var(--mute);margin:0 0 12px">5% discount on bulk orders — contact us.</p>
        <a class="btn" style="display:block;text-align:center;margin-bottom:8px" href="{{ routes.cart_url }}">View cart</a>
        <form action="{{ routes.cart_url }}" method="post"><button class="btn fill" style="width:100%" type="submit" name="checkout">Checkout</button></form>
      </div>
    {%- else -%}
      <div style="text-align:center;margin:auto"><p>Your cart is empty.</p><a class="btn fill" href="{{ routes.all_products_collection_url }}">Start shopping</a></div>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
