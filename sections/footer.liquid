<style>
  footer.site-footer {
    background: var(--cream, #f3e9db);
    border-top: none;
    padding: 68px 0 32px;
    font-size: 14px;
    color: var(--ink, #2b211a);
    margin-top: 40px;
  }
  .site-footer .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1.05fr 1.35fr;
    gap: 40px 32px;
    align-items: flex-start;
  }
  .site-footer .footer-logo {
    font-family: var(--font-head, 'Playfair Display', Georgia, serif);
    font-size: 29px;
    font-weight: 700;
    color: var(--ink, #2b211a);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    border: none;
    padding: 0;
  }
  .site-footer .footer-logo span,
  .site-footer .footer-logo b {
    color: inherit;
    font-weight: inherit;
    font-family: inherit;
  }
  .site-footer .footer-about {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(43, 33, 26, 0.85);
    margin: 0;
    max-width: 320px;
  }
  .site-footer .footer-col h4 {
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink, #2b211a);
    margin: 0 0 18px 0;
    line-height: 1.3;
  }
  .site-footer .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer .footer-col li {
    list-style: none;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 10px;
    color: rgba(43, 33, 26, 0.85);
  }
  .site-footer .footer-col li a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-footer .footer-col li a:hover {
    color: var(--acc, #8c4a2f);
  }
  .site-footer .footer-social {
    margin-top: 12px;
    color: rgba(43, 33, 26, 0.85);
    font-size: 13.5px;
  }
  .site-footer .footer-social a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-footer .footer-social a:hover {
    color: var(--acc, #8c4a2f);
    text-decoration: underline;
  }
  .site-footer .footer-copy {
    text-align: center;
    color: var(--mute, #7d6e62);
    border-top: none;
    margin-top: 55px;
    padding: 0;
    font-size: 13px;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .site-footer .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px 28px;
    }
  }
  @media (max-width: 600px) {
    footer.site-footer {
      padding: 44px 0 24px;
    }
    .site-footer .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .site-footer .footer-copy {
      margin-top: 36px;
    }
  }
</style>

<footer class="site-footer">
  <div class="w">
    <div class="f footer-grid">
      <div class="footer-col footer-col-brand">
        <a class="footer-logo" href="{{ routes.root_url }}">
          {{ section.settings.logo_text | default: 'Displays' }}<span>{{ section.settings.logo_accent | default: 'Kart' }}</span>
        </a>
        <p class="footer-about">{{ section.settings.about | default: "At Display Kart, we're dedicated to revolutionizing your display experience with quality, innovative solutions tailored to your unique needs." }}</p>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.menu_1_title | default: 'QUICK LINKS' }}</h4>
        <ul>
          {%- assign qlinks = linklists[section.settings.menu_1].links -%}
          {%- if section.settings.menu_1 != blank and section.settings.menu_1 != 'footer' and qlinks.size >= 4 -%}
            {% for link in qlinks %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {%- else -%}
            {%- assign root = routes.root_url -%}
            {%- if root == '/' -%}{%- assign root = '' -%}{%- endif -%}

            {%- assign terms_url = shop.terms_of_service.url | default: pages['terms-and-conditions'].url | default: pages['terms-conditions'].url | default: pages['terms-of-service'].url | default: pages['terms'].url -%}
            {%- if terms_url == blank -%}{%- assign terms_url = root | append: '/policies/terms-of-service' -%}{%- endif -%}

            {%- assign refund_url = shop.refund_policy.url | default: pages['refund-and-return-policy'].url | default: pages['refund-policy'].url | default: pages['refund-return-policy'].url | default: pages['returns'].url -%}
            {%- if refund_url == blank -%}{%- assign refund_url = root | append: '/policies/refund-policy' -%}{%- endif -%}

            {%- assign shipping_url = shop.shipping_policy.url | default: pages['shipping-and-delivery-policy'].url | default: pages['shipping-policy'].url | default: pages['shipping-delivery-policy'].url | default: pages['shipping'].url -%}
            {%- if shipping_url == blank -%}{%- assign shipping_url = root | append: '/policies/shipping-policy' -%}{%- endif -%}

            {%- assign privacy_url = shop.privacy_policy.url | default: pages['privacy-policy'].url | default: pages['privacy'].url -%}
            {%- if privacy_url == blank -%}{%- assign privacy_url = root | append: '/policies/privacy-policy' -%}{%- endif -%}

            {%- assign about_url = pages['about-us'].url | default: pages['about'].url -%}
            {%- if about_url == blank -%}{%- assign about_url = root | append: '/pages/about-us' -%}{%- endif -%}

            {%- assign track_url = pages['track-order'].url | default: pages['track'].url -%}
            {%- if track_url == blank -%}{%- assign track_url = root | append: '/pages/track-order' -%}{%- endif -%}

            <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
            <li><a href="{{ about_url }}">About Us</a></li>
            <li><a href="{{ blogs['news'].url | default: '/blogs/news' }}">Blog</a></li>
            <li><a href="{{ privacy_url }}" data-policy-modal="privacy">Privacy Policy</a></li>
            <li><a href="{{ terms_url }}" data-policy-modal="terms">Terms &amp; Conditions</a></li>
            <li><a href="{{ refund_url }}" data-policy-modal="refund">Refund &amp; Return Policy</a></li>
            <li><a href="{{ shipping_url }}" data-policy-modal="shipping">Shipping &amp; Delivery Policy</a></li>
            <li><a href="{{ track_url }}">Track Orders</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.menu_2_title | default: 'OUR PRODUCTS' }}</h4>
        <ul>
          {%- assign plinks = linklists[section.settings.menu_2].links -%}
          {%- if section.settings.menu_2 != blank and section.settings.menu_2 != 'footer-products' and plinks.size >= 4 -%}
            {% for link in plinks %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {%- else -%}
            <li><a href="{{ routes.collections_url }}/acrylic-sign-holders">Acrylic Sign Holders</a></li>
            <li><a href="{{ routes.collections_url }}/hotel-supplies-organizer">Hotel Supplies & Organizer</a></li>
            <li><a href="{{ routes.collections_url }}/exclusive-products">Exclusive Products</a></li>
            <li><a href="{{ routes.collections_url }}/featured-products">Featured Products</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">More Products</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.contact_title | default: 'CONTACT US' }}</h4>
        <ul>
          {%- if section.settings.business_name != blank -%}
            <li>{{ section.settings.business_name }}</li>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <li>{{ section.settings.address }}</li>
          {%- endif -%}
          {%- if section.settings.email_1 != blank -%}
            <li><a href="mailto:{{ section.settings.email_1 }}">{{ section.settings.email_1 }}</a></li>
          {%- endif -%}
          {%- if section.settings.email_2 != blank -%}
            <li><a href="mailto:{{ section.settings.email_2 }}">{{ section.settings.email_2 }}</a></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></li>
          {%- endif -%}
          <li class="footer-social">
            <a href="{{ settings.social_facebook | default: 'https://facebook.com' }}" target="_blank" rel="noopener">Facebook</a> · 
            <a href="{{ settings.social_twitter | default: 'https://twitter.com' }}" target="_blank" rel="noopener">Twitter</a> · 
            <a href="{{ settings.social_youtube | default: 'https://youtube.com' }}" target="_blank" rel="noopener">YouTube</a> · 
            <a href="{{ settings.social_linkedin | default: 'https://linkedin.com' }}" target="_blank" rel="noopener">LinkedIn</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="copy footer-copy">
      {{ section.settings.copyright_text | default: '© Copyright DisplaysKart' }}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div style="margin-top:12px">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'icon' }} {% endfor %}</div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function() {
    var policies = {
      'terms': {
        title: 'Terms & Conditions',
        body: '<h3>1. Products &amp; Pricing</h3><p>All prices listed on DisplaysKart are in Indian Rupees (INR) and inclusive of applicable GST unless specified otherwise. We specialize in premium acrylic products including sign holders, brochure stands, donation boxes, photo frames, and custom displays.</p><h3>2. Orders &amp; Bulk Enquiries</h3><p>Orders are confirmed upon successful payment verification. For bulk or wholesale orders, custom quotations and delivery timelines will be provided by our sales team.</p><h3>3. Shipping &amp; Delivery</h3><p>We deliver across India. Dispatch typically occurs within 24 to 48 business hours. Orders above ₹1000 qualify for free standard shipping.</p><h3>4. Contact &amp; Support</h3><p>For any questions regarding your order or these terms, please contact us at <b>sales@displayskart.com</b> or call <b>+91 79000 54449</b>.</p>'
      },
      'refund': {
        title: 'Refund & Return Policy',
        body: '<h3>1. Damaged or Defective Items in Transit</h3><p>Because acrylic products are fragile, please inspect your package upon delivery. If your item arrives broken, cracked, or defective, report it within <b>7 days of delivery</b> by emailing <b>support@displayskart.com</b> or contacting <b>+91 79000 54449</b> with your order number and photos/video of the packaging and damage.</p><h3>2. Replacements</h3><p>Once verified, we will arrange a free replacement of the damaged items immediately at no additional cost to you.</p><h3>3. Refunds</h3><p>If a replacement is unavailable, a full refund will be processed back to your original payment method within 5 to 7 business days.</p><h3>4. Non-Returnable Items</h3><p>Custom-fabricated acrylic products, customized branding, or personalized display units cannot be returned unless they arrive damaged or defective.</p>'
      },
      'shipping': {
        title: 'Shipping & Delivery Policy',
        body: '<h3>1. Delivery Coverage</h3><p>We ship to all serviceable pin codes across India through trusted courier partners including Delhivery, Blue Dart, and India Post.</p><h3>2. Shipping Charges</h3><p>We offer <b>Free Shipping on all orders above ₹1,000</b>. For orders below ₹1,000, standard shipping rates apply at checkout.</p><h3>3. Dispatch &amp; Delivery Timelines</h3><ul><li><b>Dispatch Time:</b> Standard orders are dispatched within 24–48 hours from our Bengaluru warehouse.</li><li><b>Delivery Time:</b> Metro cities typically receive deliveries within 2–4 business days; other regions within 4–7 business days.</li></ul><h3>4. Order Tracking</h3><p>Once your order is dispatched, you will receive an email and SMS with the courier tracking number (AWB) to track your shipment in real time.</p>'
      },
      'privacy': {
        title: 'Privacy Policy',
        body: '<h3>Information We Collect</h3><p>We collect essential information to process your orders, such as your name, shipping address, email address, and phone number.</p><h3>Data Security</h3><p>We do not sell, rent, or trade your personal information. Payment transactions are securely processed through encrypted, industry-standard payment gateways.</p>'
      }
    };

    document.addEventListener('click', function(e) {
      var t = e.target.closest('[data-policy-modal]');
      if (!t) return;
      var key = t.getAttribute('data-policy-modal');
      var item = policies[key];
      if (!item) return;
      e.preventDefault();
      var qc = document.getElementById('qc');
      var qm = document.getElementById('qm');
      var ov = document.getElementById('ov');
      if (qc && qm && ov) {
        qc.style.maxWidth = '720px';
        qc.style.display = 'block';
        qc.style.maxHeight = '85vh';
        qc.style.overflowY = 'auto';
        qc.innerHTML = '<button type="button" class="xq" data-close aria-label="Close" style="position:absolute;top:14px;right:16px;background:none;border:none;font-size:24px;cursor:pointer">×</button>' +
          '<h2 style="margin-top:0;font-size:24px">' + item.title + '</h2>' +
          '<div class="art" style="font-size:14px;line-height:1.6">' + item.body + '</div>';
        qm.classList.add('on');
        ov.classList.add('on');
        document.body.classList.add('noscroll');
      } else {
        window.location.href = t.getAttribute('href');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Displays"
    },
    {
      "type": "text",
      "id": "logo_accent",
      "label": "Logo accent",
      "default": "Kart"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text",
      "default": "At Display Kart, we're dedicated to revolutionizing your display experience with quality, innovative solutions tailored to your unique needs."
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Column 2 title",
      "default": "QUICK LINKS"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 2 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Column 3 title",
      "default": "OUR PRODUCTS"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 3 menu"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Column 4 title",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "business_name",
      "label": "Business name",
      "default": "Displayskart"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Behind Bajaj Show room, 6th Main Road HVR Layout, Kamakshi Palya – 560079, Bangaluru"
    },
    {
      "type": "text",
      "id": "email_1",
      "label": "Email 1",
      "default": "sales@displayskart.com"
    },
    {
      "type": "text",
      "id": "email_2",
      "label": "Email 2",
      "default": "support@displayskart.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 79000 54449"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© Copyright DisplaysKart"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": false
    }
  ]
}
{% endschema %}
