<section><div class="w g2">
  <div{% if section.settings.layout == 'right' %} style="order:2"{% endif %}>{% render 'img', image: section.settings.image, ratio: '600/480', placeholder: 'lifestyle-1', sizes: '(min-width:900px) 580px, 100vw' %}</div>
  <div>
    {%- if section.settings.eyebrow != blank -%}<small class="cl">{{ section.settings.eyebrow }}</small>{%- endif -%}
    <h2 style="font-size:32px;margin:6px 0 14px">{{ section.settings.heading }}</h2>
    {%- if section.blocks.size > 0 -%}
      <ul style="padding-left:18px">{%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}</ul>
    {%- else -%}
      <ul style="padding-left:18px">
        <li><b>Retail Shops</b> — risers, sign holders</li>
        <li><b>Hotels & Restaurants</b> — menu & napkin holders</li>
        <li><b>Offices</b> — name plates, organizers</li>
        <li><b>NGOs & Temples</b> — donation boxes with lock</li>
        <li><b>Exhibitions</b> · <b>Galleries & Museums</b></li>
      </ul>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<div class="muted">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<p><a class="btn fill" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a></p>{%- endif -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
