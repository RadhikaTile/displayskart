<section><div class="w">
  <div class="sh"><h2>{{ section.settings.heading }}</h2></div>
  <div class="g4 js-grid" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}&intent=related">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for item in recommendations.products -%}{% render 'product-card', product: item %}{%- endfor -%}
    {%- endif -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Products"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    }
  ]
}
{% endschema %}
