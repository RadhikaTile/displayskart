<section class="hr" style="padding:0">
  <div class="w hr2">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">★ {{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_1_label != blank -%}<a class="btn fill" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label }}</a>{%- endif -%}
      {%- if section.settings.button_2_label != blank %} &nbsp;<a class="btn" href="{{ section.settings.button_2_link | default: routes.root_url }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
    </div>
    <div class="col2">
      <div class="arch">{% render 'img', image: section.settings.image_1, ratio: '420/560', placeholder: 'hero-apparel-1', loading: 'eager', sizes: '(min-width:900px) 280px, 50vw' %}</div>
      <div style="display:grid;gap:14px">
        {% render 'img', image: section.settings.image_2, ratio: '420/300', placeholder: 'hero-apparel-2', loading: 'eager', sizes: '(min-width:900px) 280px, 50vw' %}
        {% render 'img', image: section.settings.image_3, ratio: '420/240', placeholder: 'hero-apparel-3', loading: 'eager', sizes: '(min-width:900px) 280px, 50vw' %}
      </div>
      {%- if section.settings.chip_1 != blank -%}<div class="chip a">{{ section.settings.chip_1 }}</div>{%- endif -%}
      {%- if section.settings.chip_2 != blank -%}<div class="chip b">{{ section.settings.chip_2 }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "India’s Trusted Acrylic Display Store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to DisplaysKart — acrylic displays that make every product shine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Looking to buy an acrylic display stand online in India? Sign holders, photo frames, donation boxes, brochure holders and riser stands for retail, hotels, offices and exhibitions."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Bulk Enquiry"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (tall arch)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "Floating chip 1",
      "default": "🚚 Free shipping above ₹1000"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "Floating chip 2",
      "default": "🏷️ 5% off bulk orders"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
