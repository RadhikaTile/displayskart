{%- assign menu = linklists[section.settings.menu] -%}
{%- if section.settings.show_topbar != false -%}
<div class="tb"><div class="w">
  <span>{% if section.settings.phone != blank %}📞 {{ section.settings.phone }}{% else %}📞 +91 79000 54449{% endif %}{% if section.settings.email != blank %} &nbsp;·&nbsp; ✉ {{ section.settings.email }}{% else %} &nbsp;·&nbsp; ✉ sales@displayskart.com{% endif %}</span>
  <span><a href="{% if routes.root_url == '/' %}/pages/track-order{% else %}{{ routes.root_url }}/pages/track-order{% endif %}"><u>Track Order</u></a> &nbsp;·&nbsp; {{ section.settings.topbar_right | default: 'Bengaluru, India · Pan-India delivery' }}</span>
</div></div>
{%- endif -%}
<header class="sticky" data-header>
  <div class="w hd">
    <a class="logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: height: 40, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        Displays<b>Kart</b>
      {%- endif -%}
    </a>
    <nav class="mn" aria-label="Main">
      <ul>
        {%- if menu.links.size > 3 -%}
          {%- for link in menu.links -%}
            {%- assign lt = link.title | downcase -%}
            {%- assign is_cats = false -%}
            {%- if lt contains 'collection' or lt contains 'shop' or lt contains 'categor' or lt contains 'product' or lt contains 'catalog' -%}
              {%- assign is_cats = true -%}
            {%- endif -%}
            <li{% if link.active or link.child_active %} class="on"{% endif %}>
              <a href="{{ link.url }}">{% if lt == 'catalog' %}Shop{% else %}{{ link.title }}{% endif %}{% if link.links.size > 0 or is_cats %} ▾{% endif %}</a>
              {%- if is_cats -%}
                <div class="mega">
                  <div>
                    <a href="{{ routes.collections_url }}/acrylic-sign-holders">Acrylic Sign Holders</a>
                    <a href="{{ routes.collections_url }}/acrylic-photo-frames">Acrylic Photo Frames</a>
                    <a href="{{ routes.collections_url }}/hotel-supplies-organizer">Hotel Supplies & Organizer</a>
                    <a href="{{ routes.collections_url }}/exclusive-product">Exclusive Products</a>
                  </div>
                  <div>
                    <a href="{{ routes.collections_url }}/acrylic-donation-box">Suggestion & Donation Box</a>
                    <a href="{{ routes.collections_url }}/acrylic-wall-mount-display-frames">Wall Mount Display & Frames</a>
                    <a href="{{ routes.collections_url }}/acrylic-sheets-accessories">Acrylic Sheets & Accessories</a>
                    <a href="{{ routes.collections_url }}/acrylic-label-holders-signs">Acrylic Label Holders & Signs</a>
                  </div>
                  <a href="{{ routes.all_products_collection_url }}">
                    {%- if section.settings.mega_image != blank -%}
                      {% render 'img', image: section.settings.mega_image, ratio: '190/230', sizes: '190px' %}
                    {%- else -%}
                      {% render 'img', ratio: '190/230', placeholder: 'collection-1', demo_index: 10, sizes: '190px' %}
                    {%- endif -%}
                    <b style="font-size:13px">{{ section.settings.mega_text | default: 'Exclusive Products →' }}</b>
                  </a>
                </div>
              {%- elsif link.links.size > 0 -%}
                {%- assign half = link.links.size | divided_by: 2.0 | ceil -%}
                <div class="mega">
                  <div>{% for child in link.links limit: half %}<a href="{{ child.url }}">{{ child.title }}</a>{% endfor %}</div>
                  <div>{% for child in link.links offset: half %}<a href="{{ child.url }}">{{ child.title }}</a>{% endfor %}</div>
                  <a href="{{ routes.all_products_collection_url }}">
                    {% render 'img', ratio: '190/230', placeholder: 'collection-1', demo_index: 10, sizes: '190px' %}
                    <b style="font-size:13px">All Products →</b>
                  </a>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li>
            <a href="{{ routes.all_products_collection_url }}">Shop ▾</a>
            <div class="mega">
              <div>
                <a href="{{ routes.collections_url }}/acrylic-sign-holders">Acrylic Sign Holders</a>
                <a href="{{ routes.collections_url }}/acrylic-photo-frames">Acrylic Photo Frames</a>
                <a href="{{ routes.collections_url }}/hotel-supplies-organizer">Hotel Supplies & Organizer</a>
                <a href="{{ routes.collections_url }}/exclusive-product">Exclusive Products</a>
              </div>
              <div>
                <a href="{{ routes.collections_url }}/acrylic-donation-box">Suggestion & Donation Box</a>
                <a href="{{ routes.collections_url }}/acrylic-wall-mount-display-frames">Wall Mount Display & Frames</a>
                <a href="{{ routes.collections_url }}/acrylic-sheets-accessories">Acrylic Sheets & Accessories</a>
                <a href="{{ routes.collections_url }}/acrylic-label-holders-signs">Acrylic Label Holders & Signs</a>
              </div>
              <a href="{{ routes.all_products_collection_url }}">
                {% render 'img', ratio: '190/230', placeholder: 'collection-1', demo_index: 10, sizes: '190px' %}
                <b style="font-size:13px">Exclusive Products →</b>
              </a>
            </div>
          </li>
          <li><a href="{% if routes.root_url == '/' %}/pages/applications{% else %}{{ routes.root_url }}/pages/applications{% endif %}">Applications</a></li>
          <li><a href="{% if routes.root_url == '/' %}/blogs/news{% else %}{{ routes.root_url }}/blogs/news{% endif %}">Blog</a></li>
          <li><a href="{% if routes.root_url == '/' %}/pages/about-us{% else %}{{ routes.root_url }}/pages/about-us{% endif %}">About</a></li>
          <li><a href="{% if routes.root_url == '/' %}/pages/contact{% else %}{{ routes.root_url }}/pages/contact{% endif %}">Contact Us</a></li>
        {%- endif -%}
      </ul>
    </nav>
    <div style="flex:1"></div>
    <form class="sbox{% if search.terms != blank %} has{% endif %}" action="{{ routes.search_url }}" method="get" role="search" data-search data-popular="{{ section.settings.popular_searches | escape }}">
      <input class="search" type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search products, SKU…" role="combobox" aria-expanded="false" aria-controls="sd" aria-autocomplete="list" autocomplete="off" aria-label="Search products">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="sclr" aria-label="Clear search">✕</button>
      <button type="submit" class="sgo" aria-label="Search">🔍</button>
      <div class="sdrop" id="sd" role="listbox" hidden></div>
    </form>
    <div class="ic">
      <a href="{{ routes.account_url }}" title="Account" aria-label="Account">👤</a>
      {%- if settings.enable_wishlist -%}
        <a href="{% if routes.root_url == '/' %}/pages/wishlist{% else %}{{ routes.root_url }}/pages/wishlist{% endif %}" title="Wishlist" aria-label="Wishlist">♡ <b id="wc">0</b></a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'general.cart' | t }}">🛍 <b id="cc">{{ cart.item_count }}</b></a>
    </div>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-burger>☰</button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image (optional)"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (if no image)",
      "default": "Displays"
    },
    {
      "type": "text",
      "id": "logo_accent",
      "label": "Logo accent text",
      "default": "Kart"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Show contact top bar",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 79000 54449"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "sales@displayskart.com"
    },
    {
      "type": "checkbox",
      "id": "show_track",
      "label": "Show “Track Order” link in top bar",
      "default": true
    },
    {
      "type": "text",
      "id": "topbar_right",
      "label": "Top bar right text",
      "default": "Bengaluru, India · Pan-India delivery"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "textarea",
      "id": "popular_searches",
      "label": "Popular searches (comma separated)",
      "default": "Sign holder, Photo frame, Donation box, Name plate, Riser stand, Wall mount, Napkin holder, Brochure holder"
    },
    {
      "type": "header",
      "content": "Mega menu promo (first dropdown)"
    },
    {
      "type": "image_picker",
      "id": "mega_image",
      "label": "Promo image"
    },
    {
      "type": "text",
      "id": "mega_text",
      "label": "Promo text",
      "default": "Exclusive Products →"
    },
    {
      "type": "url",
      "id": "mega_link",
      "label": "Promo link"
    }
  ]
}
{% endschema %}
