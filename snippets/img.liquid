{%- comment -%}
  Responsive image with placeholder. Params: image, ratio ("1/1"), sizes, placeholder, loading, class, alt
{%- endcomment -%}
{%- liquid
  assign r = ratio | default: '1/1'
  assign ld = loading | default: 'lazy'
  assign sz = sizes | default: '100vw'
  assign alt_text = image.alt | default: alt | default: ''
  assign ph = placeholder | default: 'image'
-%}
<div class="im{% if class != blank %} {{ class }}{% endif %}" style="aspect-ratio:{{ r }}">
  {%- if image != blank -%}
    {{- image | image_url: width: 1600 | image_tag: loading: ld, widths: '320, 480, 640, 800, 1100, 1600', sizes: sz, alt: alt_text -}}
  {%- else -%}
    {{- ph | placeholder_svg_tag -}}
  {%- endif -%}
</div>
