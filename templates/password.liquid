<div class="w" style="max-width:480px;padding:80px 20px;text-align:center">
  <h1 style="font-family:var(--font-head)">{{ shop.name }}</h1>
  <p class="muted">{{ shop.password_message | default: 'This store is password protected.' }}</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Enter store password" required style="margin-bottom:10px">
    <button class="btn fill" type="submit">Enter</button>
  {% endform %}
</div>
