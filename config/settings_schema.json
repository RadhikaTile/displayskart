    "theme_version": "1.0.1",
    "theme_author": "DisplaysKart",
    "theme_documentation_url": "https://displayskart.com",
    "theme_support_url": "https://displayskart.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#fbf6ee"
      },
      {
        "type": "color",
        "id": "color_card",
        "label": "Cards",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#2b211a"
      },
      {
        "type": "color",
        "id": "color_mute",
        "label": "Muted text",
        "default": "#7d6e62"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#eadfce"
      },
      {
        "type": "color",
        "id": "color_ph",
        "label": "Image placeholder",
        "default": "#e9dccb"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Soft section background",
        "default": "#f3e9db"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent / buttons",
        "default": "#8c4a2f"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / alerts",
        "default": "#c0432b"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "playfair_display_n7"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "default": 1200,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Use slide-out cart drawer",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (store currency)",
        "default": 1000
      }
    ]
  },
  {
    "name": "Wishlist & chat",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_wishlist",
        "label": "Enable wishlist (hearts)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_whatsapp",
        "label": "Show WhatsApp button",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number (digits, with country code)",
        "default": "917900054449"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "Twitter / X URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image (32x32 png)"
      }
    ]
  }
]